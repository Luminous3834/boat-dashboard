{
  // Config ของ Cloudflare Workers — ทำให้คำสั่ง `npx wrangler deploy` รู้ว่าต้องเอาไฟล์ไหนขึ้นเว็บ
  // เว็บนี้เป็น static ล้วน (HTML/CSS/JS อย่างเดียว ไม่มีโค้ดฝั่งเซิร์ฟเวอร์)
  // จึงไม่ต้องมีฟิลด์ "main" — มีแค่ "assets" ก็ deploy ได้
  "name": "til-dashboard",
  "compatibility_date": "2026-09-04",
  "assets": {
    // "./" = เอาไฟล์จากรากของ repo (index.html อยู่ตรงนี้)
    // ไฟล์ที่ไม่อยากให้คนนอกเปิดดูได้ ใส่ไว้ใน .assetsignore
    "directory": "./"
  },

  // ระบุให้ชัดเพื่อไม่ให้ wrangler เตือนทุกครั้งที่ deploy
  "workers_dev": true,    // เปิด URL ฟรี til-dashboard.<บัญชี>.workers.dev
  "preview_urls": false   // ไม่ต้องสร้าง URL สาธารณะแยกให้ทุก branch (ลดหน้าเว็บที่คนนอกเปิดเจอ)
}
